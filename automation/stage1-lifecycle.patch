+const store=()=>{const m=new Map;return {getItem:k=>m.has(k)?m.get(k):null,setItem:(k,v)=>{m.set(k,String(v))},removeItem:k=>{m.delete(k)},m}};
+
+test('all inline JavaScript compiles',()=>assert.doesNotThrow(()=>new vm.Script(script)));
+test('impossible tiles use finite silent scan',()=>{const body=fn('startTurn');assert.match(body,/while \(deck\.length\)/);assert.match(body,/hasPlacement/);assert.doesNotMatch(body,/Карту некуда положить/)});
+test('placement probe stops on first legal rotation',()=>{const body=fn('hasPlacement');const c={emptyCells:()=>[{x:1,y:1},{x:2,y:2}],legalRots:(t,x)=>x===2?[0]:[]};vm.runInNewContext(body,c);assert.equal(c.hasPlacement('x'),true)});
+test('finished marker is bounded and idempotent',()=>{const localStorage=store(),c={localStorage,Date:{now:()=>7},JSON,FINISHED_GAMES_KEY:'finishedGames'};vm.runInNewContext(fn('jsonRead')+';'+fn('markGameFinished'),c);for(let i=0;i<205;i++)c.markGameFinished('l:'+i);c.markGameFinished('l:204');const a=JSON.parse(localStorage.getItem('finishedGames'));assert.equal(a.length,200);assert.equal(a.filter(x=>x.k==='l:204').length,1)});
+test('finished saved game is rejected and removed',()=>{const localStorage=store();localStorage.setItem('finishedGames',JSON.stringify([{k:'l:g'}]));localStorage.setItem('savedGame',JSON.stringify({cfg:{localId:'g'},moves:[]}));let rendered=0;const c={localStorage,JSON,gameLog:null,renderResume:()=>rendered++,FINISHED_GAMES_KEY:'finishedGames'};vm.runInNewContext(fn('jsonRead')+';'+fn('gameKey')+';'+fn('gameFinished')+';'+fn('clearSave')+';'+fn('loadSave'),c);assert.equal(c.loadSave(),null);assert.equal(localStorage.getItem('savedGame'),null);assert.equal(rendered,1)});
+test('active save is blocked in terminal phase',()=>{const localStorage=store(),c={localStorage,JSON,gameLog:{cfg:{localId:'x'},moves:[]},net:null,tut:null,phase:'end'};vm.runInNewContext(fn('jsonRead')+';'+fn('gameKey')+';'+fn('gameFinished')+';'+fn('saveGame'),c);c.saveGame();assert.equal(localStorage.getItem('savedGame'),null)});
+test('history replaces preliminary row with final row',()=>{const localStorage=store(),players=[{name:'A',score:3,col:'r'}],c={localStorage,JSON,Date:{now:()=>9},gameLog:{cfg:{localId:'x'}},players,isMe:()=>true,GAME_HISTORY_KEY:'gameHistory'};vm.runInNewContext(fn('jsonRead')+';'+fn('gameKey')+';'+fn('historySave'),c);c.historySave('deck',false);c.historySave('deck',true);const a=JSON.parse(localStorage.getItem('gameHistory'));assert.equal(a.length,1);assert.equal(a[0].final,true)});
+test('remote move reserves its number before catch-up yield',()=>{const body=fn('pumpRemote');assert.ok(body.indexOf('applied++')<body.indexOf('await new Promise'));assert.ok(body.indexOf("fits(current.type")<body.indexOf('await new Promise'))});
+test('network queue rejects old and duplicate move numbers',()=>{const body=fn('onMove');assert.match(body,/m\.n < applied/);assert.match(body,/queue\.some\(q => q\.n === m\.n\)/)});
+test('duplicate start message has an explicit guard',()=>assert.match(script,/if \(m\.t === 'start'\) \{\s*if \(net\.gameId === d\.id\) return;/));
+test('terminal marker precedes asynchronous final scoring',()=>{const body=fn('endGame');assert.ok(body.indexOf('markGameFinished')<body.indexOf('await wait'));assert.ok(body.indexOf('historySave(reason, false)')<body.indexOf('await wait'));assert.match(body,/phase === 'end' \|\| ending/)});
+test('return from background routes terminal game home',()=>assert.match(script,/if \(phase === 'end' && !mm\) \{ closeGameMenu\(\); show\('menu'\); \}/));
+test('confirmation dialog is singleton and actions are one-shot',()=>{const body=fn('confirmBox');assert.match(body,/getElementById\('confirmBox'\)/);assert.match(body,/let done = false/);assert.match(body,/if \(done\) return/);assert.match(body,/alertdialog/)});
+test('test source does not contain secret material',()=>{for(const p of ['tests/lifecycle.test.cjs','docs/PROJECT-CONTEXT.md','docs/SECURITY-RESPONSE.md']){const s=fs.readFileSync(p,'utf8');assert.doesNotMatch(s,/-----BEGIN (?:RSA )?PRIVATE KEY-----/)}});
