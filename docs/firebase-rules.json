{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "msgs": {
          "$id": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 4000"
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['t']) && newData.child('t').isNumber() && newData.child('t').val() <= now)"
      }
    },
    "leaders": {
      ".read": "auth != null",
      ".indexOn": [
        "r"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 'r', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('r').isNumber() && newData.child('r').val() >= 0 && newData.child('r').val() <= (data.exists() ? data.child('r').val() : 0) + 30 && newData.child('t').val() === now && (!data.exists() || now - data.child('t').val() > 60000)"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['w', 't']) && newData.child('w').isString() && newData.child('w').val().length < 20000"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        "$fid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12"
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$key": {
          ".write": "auth != null && (auth.uid === $uid || $key === auth.uid + '_f' || $key === auth.uid + '_r')",
          ".validate": "!newData.exists() || auth.uid === $uid || (newData.hasChildren(['k', 'n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').val() === now)"
        }
      }
    },
    "fcodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "$code.length === 6"
      }
    }
  }
}
