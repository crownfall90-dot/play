{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "msgs": {
          "$id": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length < 4000 && (!newData.child('u').exists() || newData.child('u').val() === auth.uid)"
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['t']) && newData.child('t').isNumber() && newData.child('t').val() <= now)"
      }
    },
    "leaders": {
      ".read": "auth != null",
      ".indexOn": [
        "r"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 'r', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('r').isNumber() && newData.child('r').val() >= 0 && newData.child('r').val() <= (data.exists() ? data.child('r').val() : 0) + 30 && newData.child('t').val() === now && (!data.exists() || now - data.child('t').val() > 60000) && (!newData.hasChild('s') || (newData.child('s').isString() && newData.child('s').val().length <= 16)) && (!newData.hasChild('sr') || (newData.child('sr').isNumber() && newData.child('sr').val() >= 0))"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['w', 't']) && newData.child('w').isString() && newData.child('w').val().length < 20000"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        "$fid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (auth.token.email != null && root.child('profiles').child(auth.uid).exists() && root.child('profiles').child($fid).exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12)"
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$key": {
          ".write": "auth != null && (auth.uid === $uid || (($key === auth.uid + '_f' || $key === auth.uid + '_r') && auth.token.email != null && root.child('profiles').child(auth.uid).exists() && root.child('profiles').child($uid).exists()))",
          ".validate": "!newData.exists() || auth.uid === $uid || (newData.hasChildren(['k', 'n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').val() === now)"
        }
      }
    },
    "fcodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && auth.token.email != null && root.child('profiles').child(auth.uid).exists()",
        ".validate": "$code.length === 6"
      }
    },
    "fcodeOf": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && auth.token.email != null && root.child('profiles').child(auth.uid).exists()",
        ".validate": "newData.isString() && root.child('fcodes').child(newData.val()).val() === $uid"
      }
    },
    "guestN": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
    },
    "playerNo": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === root.child('guestN').val()"
      }
    },
    "feedback": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        "$key": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['k', 'm', 't']) && newData.child('k').isString() && newData.child('m').isString() && newData.child('m').val().length <= 1500 && newData.child('t').val() === now"
        }
      }
    },
    "suggestions": {
      "names": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('t').val() === now"
        }
      }
    },
    "config": {
      "maintenance": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['active']) && newData.child('active').isBoolean() && (!newData.child('message').exists() || (newData.child('message').isString() && newData.child('message').val().length <= 500))"
      },
      "testerPin": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,8}$/)"
      }
    },
    "promo_claims": {
      "$code": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['t']) && newData.child('t').val() === now"
        }
      }
    },
    "errors": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['m', 'ts']) && newData.child('m').isString() && newData.child('m').val().length <= 500 && newData.child('ts').val() === now && (!newData.child('ua').exists() || (newData.child('ua').isString() && newData.child('ua').val().length <= 200)) && (!newData.child('ver').exists() || (newData.child('ver').isString() && newData.child('ver').val().length <= 40)) && (!newData.child('uid').exists() || (newData.child('uid').isString() && newData.child('uid').val().length <= 64)) && (!newData.child('dev').exists() || (newData.child('dev').isString() && newData.child('dev').val().length <= 200)) && (!newData.child('trail').exists() || (newData.child('trail').isString() && newData.child('trail').val().length <= 200))"
      },
      ".indexOn": [
        "uid"
      ]
    },
    "promo_codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['active', 'gold']) && newData.child('active').isBoolean() && newData.child('gold').isNumber() && newData.child('gold').val() > 0 && newData.child('gold').val() <= 1000"
      }
    },
    "admins": {
      ".read": false,
      ".write": false
    },
    "logs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        "$id": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "!newData.exists() || (newData.hasChildren(['t', 'k']) && newData.child('t').val() === now && newData.child('k').isString() && newData.child('k').val().length <= 24 && (!newData.child('d').exists() || (newData.child('d').isString() && newData.child('d').val().length <= 240)) && (!newData.child('c').exists() || newData.child('c').isNumber()))"
        }
      }
    }
  }
}
